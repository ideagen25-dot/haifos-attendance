# ========================================================
# HAIFOS PORTAL - ENVIRONMENT VARIABLES
# ========================================================

# Supabase Cloud Database & Auth (Free Tier)
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Used exclusively by Netlify Serverless Functions)
# KEEP THIS SECRET - Set in Netlify Site Configuration -> Environment Variables
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Free EmailJS (Automated Certificate Dispatch)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
